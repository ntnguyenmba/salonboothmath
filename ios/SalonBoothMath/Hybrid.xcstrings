        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn còn lại %@. Xem cách trả hiện tại thực sự đang tốn của bạn bao nhiêu."
          }
        }
      }
    },
    "paywall.benefitCompare": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare booth rent, commission, and hybrid with your real numbers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara renta de puesto, comisión e híbrido con tus números reales"
