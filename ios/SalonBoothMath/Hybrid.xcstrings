    "paywall.takeHomeLead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You take home %@. See what your current setup is really costing you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te llevas %@. Mira cuánto te cuesta realmente tu forma de pago actual."
