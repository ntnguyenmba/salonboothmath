        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoản để dành thuế là ước tính tùy chọn. Khoản này không bị trừ khỏi tiền còn lại."
          }
        }
      }
    },
    "settings.taxNote": {
      "localizations": {
