        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "So sánh thuê chỗ, chia phần và kết hợp bằng số thật của bạn"
          }
        }
      }
    },
    "paywall.benefitDifference": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the exact dollars you gain or give up with each setup"
