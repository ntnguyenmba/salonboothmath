    "br.taxNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tax set-aside is an optional estimate. It is not taken out of what you take home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reserva para impuestos es una estimación opcional. No se descuenta de lo que te llevas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoản để dành thuế là ước tính tùy chọn. Khoản này không bị trừ khỏi tiền còn lại."
          }
        }
      }
    },
    "settings.taxNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional estimate only. This does not reduce what you take home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una estimación opcional. No reduce lo que te llevas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ là ước tính tùy chọn. Không làm giảm số tiền còn lại hiển thị."
          }
        }
      }
    },
