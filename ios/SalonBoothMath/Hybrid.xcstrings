    },
    "decisions.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this week's numbers to see how your pay setup compares and what could leave you with more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa los números de esta semana para comparar tu forma de pago y ver cuál podría dejarte más."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng số liệu tuần này để so sánh cách nhận tiền và xem cách nào có thể giúp bạn giữ lại nhiều hơn."
          }
        }
      }
    },
